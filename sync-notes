#!/usr/bin/env python3
"""
Sync published notes from ~/wiki to the blog.

Usage: ./sync-notes [note-id ...]
       ./sync-notes              # sync all published notes
       ./sync-notes de14645c     # sync specific note(s)

For each published note:
  - Pulls latest content from ~/wiki/<id>.md
  - Preserves blog-specific frontmatter (tags, etc.)
  - Re-resolves wiki-links (picks up newly published links)
  - Updates the published: URL in the wiki note if needed
"""

import re
import sys

from blog_utils import (
    WIKI_DIR,
    NOTES_DIR,
    BASE_URL,
    parse_frontmatter,
    parse_tags,
    slugify,
    resolve_wikilinks,
    extract_title,
    find_blog_note,
    extract_note_id,
    get_blog_tags,
    ensure_published_link,
)


def sync_note(note_id: str) -> bool:
    """
    Sync a single note from wiki to blog.

    Returns True if changes were made, False otherwise.
    """
    wiki_path = WIKI_DIR / f"{note_id}.md"
    blog_path = find_blog_note(note_id)

    if not wiki_path.exists():
        print(f"  Warning: wiki note not found: {wiki_path}")
        return False

    if not blog_path:
        print(f"  Warning: blog note not found (use publish-note first)")
        return False

    # Read wiki note
    wiki_content = wiki_path.read_text()
    wiki_meta, wiki_body = parse_frontmatter(wiki_content)

    # Read current blog note to preserve blog-specific metadata
    blog_content = blog_path.read_text()
    blog_meta, _ = parse_frontmatter(blog_content)

    # Extract title from wiki body
    title, body = extract_title(wiki_body)
    if not title:
        print(f"  Warning: no title found in {wiki_path}")
        return False

    # Keep the original publication date from the blog
    jekyll_date = blog_meta.get("date", "")

    # Resolve wiki-links (re-resolve in case new notes are now published)
    body = resolve_wikilinks(body)

    # Build slug and permalink
    slug = slugify(title)
    permalink = f"/{note_id}/{slug}"
    published_url = f"{BASE_URL}{permalink}"

    # Merge tags: keep blog tags (like 'article'), add wiki tags
    blog_tags = get_blog_tags(note_id)
    wiki_tags = parse_tags(wiki_meta.get("tags", ""))

    # Preserve blog-only tags, update with wiki tags
    merged_tags = list(blog_tags)
    for tag in wiki_tags:
        if tag not in merged_tags:
            merged_tags.append(tag)

    # Build Jekyll frontmatter
    frontmatter_lines = [
        "---",
        "layout: post",
        f"title: \"{title}\"",
        f"date: {jekyll_date}",
        f"permalink: {permalink}",
        "redirect_from:",
        f"  - /{note_id}",
    ]

    # Preserve old URL redirects if they exist
    redirect_match = re.search(
        r"redirect_from:\s*\n((?:\s+-\s+[^\n]+\n?)+)",
        blog_content
    )
    if redirect_match:
        existing_redirects = re.findall(r"-\s+(/[^\n]+)", redirect_match.group(1))
        for redirect in existing_redirects:
            if redirect != f"/{note_id}" and redirect not in frontmatter_lines:
                frontmatter_lines.append(f"  - {redirect}")

    if merged_tags:
        frontmatter_lines.append(f"tags: [{', '.join(merged_tags)}]")

    frontmatter_lines.append("---")

    new_content = "\n".join(frontmatter_lines) + "\n\n" + body

    if not new_content.endswith("\n"):
        new_content += "\n"

    # Determine the correct filename (may have changed if title changed)
    new_filename = f"{note_id}-{slug}.md"
    new_blog_path = NOTES_DIR / new_filename

    # Check if content changed or filename needs updating
    content_changed = new_content != blog_content
    filename_changed = blog_path != new_blog_path

    if not content_changed and not filename_changed:
        return False

    # Write updated blog note
    new_blog_path.write_text(new_content)

    # Remove old file if renamed
    if filename_changed and blog_path.exists():
        blog_path.unlink()
        print(f"  Renamed: {blog_path.name} -> {new_blog_path.name}")
    else:
        print(f"  Updated: {new_blog_path}")

    # Ensure wiki note has correct published URL
    ensure_published_link(wiki_path, published_url)

    return True


def main():
    # Get list of note IDs to sync
    if len(sys.argv) > 1:
        note_ids = sys.argv[1:]
    else:
        # Sync all notes in _notes/
        note_ids = [extract_note_id(p.name) for p in NOTES_DIR.glob("*.md")]

    if not note_ids:
        print("No notes to sync.")
        return

    print(f"Syncing {len(note_ids)} note(s)...")

    updated = 0
    for note_id in sorted(note_ids):
        print(f"\n{note_id}:")
        if sync_note(note_id):
            updated += 1
        else:
            print("  No changes")

    print(f"\nDone. Updated {updated} note(s).")


if __name__ == "__main__":
    main()
