#!/usr/bin/env python3
"""
Publish captioned photos from the Photos library as photo posts.

Usage: ./sync-photos           # update published photos from the library
       ./sync-photos triage    # decide which captioned photos to publish
       ./sync-photos list      # list photos that haven't been triaged
       ./sync-photos publish <uuid> [--title TITLE]
       ./sync-photos ignore <uuid> ...

Any photo with a caption is a candidate. Nothing from the library enters the
repo until you choose to publish it. Publishing assigns the photo a note ID,
copies a resized, metadata-free image to images/, and writes a note tagged
`photo` with the caption as its body, dated when the photo was taken.

Photo posts are untitled unless you give them a title. An untitled post is
marked `untitled: true`, lives at /<id>, and is shown as its photo and caption
instead of a heading. Its `title` is a summary of the caption, used only where
text is required (browser tabs, link previews, commit messages), and follows
caption changes.

A published note records its source in `photo: <uuid>` frontmatter. Photos you
choose never to publish are listed by UUID in IGNORED_FILE, which is
gitignored so those choices stay private. Editing a caption
during triage saves it back to the Photos library, which stays the source of
truth for captions.
"""

import argparse
import contextlib
import os
import random
import re
import string
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import unquote

from photos import Photo, load_photos, set_caption
from image_captions import CaptionSync, choose_alt
from image_markup import images, markdown_alt, marker, plain_text

from blog_utils import (
    BASE_URL,
    BLOG_DIR,
    IMAGES_DIR,
    NOTES_DIR,
    WIKI_DIR,
    blog_image_name,
    collect_all_tags,
    commit_if_pending,
    error_text,
    export_photo_image,
    extract_note_id,
    import_image,
    jj_tug,
    parse_frontmatter,
    serialize_yaml_scalar,
    slugify,
    sync_all_tag_artifacts,
)

IGNORED_FILE = BLOG_DIR / "_ignored-photos.txt"
PHOTO_TAG = "photo"
MAX_TITLE_LENGTH = 60


def read_ignored() -> set[str]:
    if not IGNORED_FILE.exists():
        return set()
    return {
        line.strip() for line in IGNORED_FILE.read_text().splitlines()
        if line.strip()
    }


def write_ignored(uuids: set[str]) -> None:
    IGNORED_FILE.write_text("".join(f"{u}\n" for u in sorted(uuids)))


def published_photos() -> dict[str, Path]:
    """Map photo UUID -> note path for every published photo note."""
    published = {}
    for path in NOTES_DIR.glob("*.md"):
        metadata, _ = parse_frontmatter(path.read_text())
        if metadata.get("photo"):
            published[metadata["photo"]] = path
    return published


def caption_summary(caption: str) -> str:
    """The caption's first line, shortened at a word boundary if long."""
    first_line = caption.strip().splitlines()[0].strip()
    if len(first_line) <= MAX_TITLE_LENGTH:
        return first_line
    cut = first_line[:MAX_TITLE_LENGTH].rsplit(" ", 1)[0]
    return cut.rstrip(" ,;:.-") + "…"


def note_body(
    image_name: str, caption: str, *, uuid: str = "",
    alt: str | None = None,
) -> str:
    path = f"</images/{image_name}>" if " " in image_name else (
        f"/images/{image_name}"
    )
    # Each line of a caption is its own paragraph, so line breaks survive
    # Markdown rendering.
    paragraphs = [line.strip() for line in caption.splitlines()]
    text = "\n\n".join(p for p in paragraphs if p)
    link = marker(uuid, manual=alt is not None) if uuid else ""
    alt_text = markdown_alt(caption if alt is None else alt)
    return f"![{alt_text}]({path}){link}\n\n{text}\n"


def new_note_id() -> str:
    """A random 12 character ID unused by blog and wiki notes."""
    alphabet = string.ascii_letters + string.digits
    while True:
        note_id = "".join(random.choices(alphabet, k=12))
        taken = (
            any(NOTES_DIR.glob(f"{note_id}*"))
            or (WIKI_DIR / f"{note_id}.md").exists()
        )
        if not taken:
            return note_id


def parse_tag_input(text: str) -> list[str]:
    """Tags typed as a comma or space separated list, normalized to
    lowercase-with-hyphens (each tag names a feed file and a directory).
    The photo tag is implied, so it's dropped here."""
    tags = []
    for word in re.split(r"[,\s]+", text):
        tag = slugify(word)
        if tag and tag != PHOTO_TAG and tag not in tags:
            tags.append(tag)
    return tags


def photo_frontmatter(
    note_id: str, title: str | None, caption: str, date: str,
    image_name: str, uuid: str, tags: list[str] = (),
) -> str:
    """Frontmatter for a photo note; title None makes it untitled."""
    lines = ["---", "layout: post"]
    if title:
        slug = slugify(title)
        lines += [
            f"title: {serialize_yaml_scalar(title)}",
            f"date: {date}",
            f"permalink: /{note_id}/{slug}",
            "redirect_from:",
            f"  - /{note_id}",
        ]
    else:
        lines += [
            f"title: {serialize_yaml_scalar(caption_summary(caption))}",
            "untitled: true",
            f"date: {date}",
            f"permalink: /{note_id}",
        ]
    lines += [
        f"tags: [{', '.join([PHOTO_TAG, *tags])}]",
        f"image: /images/{image_name}",
        f"photo: {uuid}",
        "---",
    ]
    return "\n".join(lines)


def photo_note_name(note_id: str, title: str | None) -> str:
    return f"{note_id}-{slugify(title)}.md" if title else f"{note_id}.md"


def publish_photo(
    photo: Photo, title: str | None, tags: list[str] = (),
    *, alt: str | None = None,
) -> str:
    """Write the image and note for photo; title None makes it untitled.
    Returns the published URL."""
    if not photo.source.exists():
        raise FileNotFoundError(
            f"image file isn't in the library (it may only be in iCloud): "
            f"{photo.source}"
        )
    note_id = new_note_id()
    image_path, _ = export_photo_image(photo.source, photo.uuid)
    image_name = image_path.name

    frontmatter = photo_frontmatter(
        note_id, title, photo.caption, post_date(photo), image_name,
        photo.uuid, tags,
    )
    path = NOTES_DIR / photo_note_name(note_id, title)
    path.write_text(frontmatter + "\n\n" + note_body(
        image_name, photo.caption, uuid=photo.uuid, alt=alt,
    ))
    print(f"Created: _notes/{path.name}")
    permalink = parse_frontmatter(frontmatter + "\n")[0]["permalink"]
    return BASE_URL + permalink


def post_date(photo: Photo) -> str:
    """The post date: when the photo was taken, in its own time zone."""
    return photo.taken.strftime("%Y-%m-%d %H:%M %z")


def _set_field(frontmatter: str, key: str, value: str) -> str:
    return re.sub(
        rf"^{key}: .*$", lambda _: f"{key}: {value}", frontmatter,
        count=1, flags=re.MULTILINE,
    )


def refresh_note(photo: Photo, note_path: Path) -> bool:
    """Update a published note from the photo in the library: its date,
    its caption body, and for an untitled note its caption summary title.
    A chosen title and the image are left alone. Returns True if changed."""
    content = note_path.read_text()
    metadata, body = parse_frontmatter(content)
    image_name = metadata.get("image", "").removeprefix("/images/")
    refs = images(body)
    alt = None
    if refs:
        image = refs[0]
        if image.manual:
            alt = image.alt
        elif (not image.uuid and image.alt
              and plain_text(image.alt) != plain_text(photo.caption)):
            chosen, manual = choose_alt(
                image_name, image.alt, photo.caption, True,
            )
            if manual:
                alt = chosen
            elif chosen != photo.caption:
                set_caption(photo, chosen)
                photo.caption = chosen
    frontmatter = content[: len(content) - len(body)]
    frontmatter = _set_field(frontmatter, "date", post_date(photo))
    if metadata.get("untitled") == "true" and photo.caption:
        summary = serialize_yaml_scalar(caption_summary(photo.caption))
        frontmatter = _set_field(frontmatter, "title", summary)
    new_content = frontmatter + note_body(
        image_name, photo.caption, uuid=photo.uuid, alt=alt,
    )
    if new_content == content:
        return False
    note_path.write_text(new_content)
    return True


def untriaged(photos: list[Photo]) -> list[Photo]:
    done = read_ignored() | published_photos().keys()
    for path in NOTES_DIR.glob("*.md"):
        done.update(image.uuid for image in images(path.read_text()) if image.uuid)
    return [p for p in photos if p.caption and p.uuid not in done]


def refresh_linked_notes(photos: list[Photo]) -> int:
    """Refresh only linked image alt text in ordinary blog and wiki notes."""
    captions = CaptionSync(photos)
    changed = 0
    for path in sorted(NOTES_DIR.glob("*.md")):
        content = path.read_text()
        metadata, _ = parse_frontmatter(content)
        if "photo" in metadata:
            continue
        note_id = extract_note_id(path.name)
        wiki_path = WIKI_DIR / f"{note_id}.md"
        # The wiki owns the markers and manual alt text. Copy only marked
        # image edits into the blog, without publishing other wiki edits.
        if not wiki_path.exists():
            continue
        wiki_content = wiki_path.read_text()
        if not any(image.uuid for image in images(wiki_content)):
            continue
        updated_wiki = captions.sync(wiki_content, note_id, linked_only=True)
        if updated_wiki != wiki_content:
            wiki_path.write_text(updated_wiki)
        by_path: dict[str, list] = {}
        by_uuid: dict[str, list] = {}
        for image in images(updated_wiki):
            if image.path.startswith(("/", "http:", "https:")):
                continue
            blog_path = "/images/" + blog_image_name(
                note_id, Path(unquote(image.path)),
            )
            by_path.setdefault(blog_path, []).append(image)
            if image.uuid:
                by_uuid.setdefault(image.uuid, []).append(image)
        edits = []
        for image in images(content):
            matches = (by_uuid.get(image.uuid, []) if image.uuid
                       else by_path.get(unquote(image.path), []))
            if not matches:
                continue
            source = matches.pop(0)
            if source.uuid:
                edits.append((image.start, image.end, image.render(
                    source.alt, source.uuid, source.manual,
                )))
        for start, end, replacement in reversed(edits):
            content = content[:start] + replacement + content[end:]
        if content != path.read_text():
            path.write_text(content)
            changed += 1
            print(f"  {path.name}: updated linked image alt text")
    return changed


def describe(photo: Photo) -> str:
    taken = photo.taken.strftime("%Y-%m-%d %H:%M")
    return f"{photo.uuid}  {taken}  {photo.original_filename}"


def preview(photo: Photo) -> subprocess.Popen | None:
    """Show photo in Quick Look; returns the process to close later."""
    try:
        return subprocess.Popen(
            ["qlmanage", "-p", str(photo.source)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError as e:
        print(f"  (couldn't open a preview: {e})")
        return None


def close_preview(proc: subprocess.Popen | None) -> None:
    if proc and proc.poll() is None:
        proc.terminate()
        proc.wait()


def ask(prompt: str) -> str:
    try:
        return input(prompt).strip()
    except EOFError:
        return "q"


def ask_tags() -> list[str] | None:
    """Ask for extra tags, with tab completion of existing ones.
    Returns None if the user backs out."""
    known = sorted(collect_all_tags() - {PHOTO_TAG})
    print(f"  Existing tags: {', '.join(known)}")
    with tag_completion(known):
        answer = ask("  Tags (Enter for none, '-' to go back): ")
    return None if answer == "-" else parse_tag_input(answer)


@contextlib.contextmanager
def tag_completion(tags: list[str]):
    """Tab-complete the word being typed from tags, if readline exists."""
    try:
        import readline
    except ImportError:
        yield
        return

    def complete(text: str, state: int) -> str | None:
        matches = [t for t in tags if t.startswith(text)]
        return matches[state] if state < len(matches) else None

    old_completer = readline.get_completer()
    old_delims = readline.get_completer_delims()
    readline.set_completer(complete)
    readline.set_completer_delims(" ,")
    # macOS Python may use libedit, which spells the binding differently.
    if "libedit" in (readline.__doc__ or ""):
        readline.parse_and_bind("bind ^I rl_complete")
    else:
        readline.parse_and_bind("tab: complete")
    try:
        yield
    finally:
        readline.set_completer(old_completer)
        readline.set_completer_delims(old_delims)


def ask_title() -> str | None:
    """Ask for a title. Returns None if the user backs out."""
    answer = ask("  Title (Enter to go back): ")
    return answer or None


def edit_text(text: str) -> str:
    """Let the user edit text in $VISUAL or $EDITOR (default vi)."""
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    with tempfile.NamedTemporaryFile(
        "w+", suffix=".md", prefix="caption-", delete=False,
    ) as f:
        f.write(text + "\n")
        path = Path(f.name)
    try:
        # The editor variable may include arguments, e.g. "code --wait".
        subprocess.run(
            ["/bin/sh", "-c", f'{editor} "$1"', "sh", str(path)],
            check=True,
        )
        return path.read_text().strip()
    finally:
        path.unlink(missing_ok=True)


def edit_caption(photo: Photo) -> None:
    """Edit photo's caption and save it back to the Photos library."""
    try:
        caption = edit_text(photo.caption)
    except (OSError, subprocess.CalledProcessError) as e:
        print(f"  Error: couldn't run the editor: {error_text(e)}")
        return
    if not caption:
        print("  Caption can't be empty; left unchanged.")
        return
    if caption == photo.caption:
        print("  Caption unchanged.")
        return
    try:
        set_caption(photo, caption)
    except (OSError, subprocess.CalledProcessError) as e:
        print(
            "  Error: couldn't save the caption to Photos (macOS may need "
            "permission for your terminal to control Photos, under System "
            "Settings > Privacy & Security > Automation): "
            f"{error_text(e)}"
        )
        return
    photo.caption = caption
    print("  Caption saved to Photos:")
    print("  " + photo.caption.replace("\n", "\n  "))


TRIAGE_HELP = """\
  p  publish this photo untitled (you can add tags first)
  t  publish this photo with a title (and tags)
  e  edit the caption (saved back to Photos)
  i  ignore: never offer this photo again
  s  skip: decide later
  v  view the photo again
  q  quit (publishes so far are committed)"""


def triage(photos: list[Photo]) -> tuple[list[str], int]:
    """Interactively decide on untriaged photos.
    Returns (titles or caption summaries of published photos,
    number ignored)."""
    pending = untriaged(photos)
    if not pending:
        print("No untriaged captioned photos.")
        return [], 0
    print(f"{len(pending)} captioned photo(s) to triage, newest first.")
    print(TRIAGE_HELP)

    ignored = read_ignored()
    published_titles: list[str] = []
    ignored_count = 0
    for index, photo in enumerate(pending, start=1):
        print(f"\n[{index}/{len(pending)}] {describe(photo)}")
        print("  " + photo.caption.replace("\n", "\n  "))
        proc = preview(photo)
        try:
            while True:
                choice = ask(
                    "  [p]ublish (with [t]itle), [e]dit, [i]gnore, [s]kip, "
                    "[v]iew, [q]uit? "
                )
                choice = choice[:1].lower()
                if choice in ("p", "t"):
                    title = None
                    if choice == "t":
                        title = ask_title()
                        if title is None:
                            continue
                    tags = ask_tags()
                    if tags is None:
                        continue
                    try:
                        alt = input(
                            "  Alt text (Enter for caption, '-' to go back, "
                            "or manual text): "
                        ).strip()
                    except EOFError:
                        return published_titles, ignored_count
                    if alt == "-":
                        continue
                    try:
                        url = publish_photo(photo, title, tags, alt=alt or None)
                    except (FileNotFoundError,
                            subprocess.CalledProcessError) as e:
                        print(f"  Error: couldn't publish: {error_text(e)}")
                        continue
                    print(f"  Will be at {url}")
                    published_titles.append(
                        title or caption_summary(photo.caption)
                    )
                    break
                if choice == "e":
                    edit_caption(photo)
                    continue
                if choice == "i":
                    ignored.add(photo.uuid)
                    write_ignored(ignored)
                    ignored_count += 1
                    break
                if choice == "s":
                    break
                if choice == "v":
                    close_preview(proc)
                    proc = preview(photo)
                    continue
                if choice == "q":
                    return published_titles, ignored_count
                print(TRIAGE_HELP)
        finally:
            close_preview(proc)
    return published_titles, ignored_count


def find_photo(photos: list[Photo], uuid: str) -> Photo:
    for photo in photos:
        if photo.uuid == uuid:
            return photo
    sys.exit(f"Error: no captioned photo with UUID {uuid}")


def commit_message(published: list[str], refreshed: int) -> str:
    parts = []
    if published:
        parts.append(
            f"Publish photo {published[0]}" if len(published) == 1
            else f"Publish {len(published)} photos"
        )
    if refreshed:
        parts.append(f"update {refreshed} photo post(s) from Photos")
    subject = ", ".join(parts)
    subject = subject[:1].upper() + subject[1:]
    if len(published) > 1:
        subject += "\n\n" + "\n".join(f"- {t}" for t in published)
    return subject


def refresh_all(photos: list[Photo]) -> int:
    """Update every published photo note from the library.
    Returns the number changed."""
    by_uuid = {p.uuid: p for p in photos}
    changed = 0
    for uuid, note_path in sorted(published_photos().items()):
        photo = by_uuid.get(uuid)
        if photo is None:
            print(
                f"  {note_path.name}: warning: photo {uuid} is no longer a "
                "visible photo in the library; leaving the note as is"
            )
            continue
        if refresh_note(photo, note_path):
            print(f"  {note_path.name}: updated from Photos")
            changed += 1
    return changed


def main():
    parser = argparse.ArgumentParser(
        description="Publish captioned photos from the Photos library."
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("triage", help="decide which captioned photos to publish")
    sub.add_parser("list", help="list photos that haven't been triaged")
    pub = sub.add_parser("publish", help="publish one photo")
    pub.add_argument("uuid")
    pub.add_argument("--title", help="omit for an untitled post")
    pub.add_argument("--alt", help="independent manual alt text (default: caption)")
    pub.add_argument(
        "--tags", default="",
        help=f"comma separated tags besides {PHOTO_TAG}",
    )
    ign = sub.add_parser("ignore", help="never offer these photos again")
    ign.add_argument("uuids", nargs="+")
    args = parser.parse_args()

    all_photos = load_photos()
    photos = [photo for photo in all_photos if photo.caption]

    if args.command == "list":
        for photo in untriaged(photos):
            first_line = photo.caption.splitlines()[0]
            print(f"{describe(photo)}  {first_line}")
        return

    # Separate any pre-existing WIP from this run.
    commit_if_pending()

    published: list[str] = []
    ignored = 0
    refreshed = 0
    if args.command == "triage":
        published, ignored = triage(photos)
    elif args.command == "publish":
        photo = find_photo(photos, args.uuid)
        if photo.uuid in published_photos():
            sys.exit(f"Error: {photo.uuid} is already published")
        try:
            url = publish_photo(
                photo, args.title or None, parse_tag_input(args.tags), alt=args.alt,
            )
            print(f"Published: {url}")
        except (FileNotFoundError, subprocess.CalledProcessError) as e:
            sys.exit(f"Error: couldn't publish {photo.uuid}: {error_text(e)}")
        published = [args.title or caption_summary(photo.caption)]
    elif args.command == "ignore":
        uuids = read_ignored()
        for uuid in args.uuids:
            uuids.add(find_photo(photos, uuid).uuid)
        ignored = len(uuids - read_ignored())
        write_ignored(uuids)
    else:
        refreshed = refresh_all(all_photos)
        remaining = len(untriaged(photos))
        print(
            f"Done. Updated {refreshed} photo post(s); {remaining} captioned "
            "photo(s) untriaged (run `sync-photos triage`)."
        )

    if args.command in (None, "triage", "publish"):
        linked = refresh_linked_notes(all_photos)
        if linked:
            print(f"Updated alt text in {linked} linked note(s).")
            refreshed += linked

    if published:
        sync_all_tag_artifacts()
    if ignored:
        print(f"Ignored {ignored} photo(s).")
    if commit_if_pending(commit_message(published, refreshed)):
        jj_tug()


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as e:
        sys.exit(f"Error: {error_text(e)}")
