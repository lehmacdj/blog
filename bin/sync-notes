#!/usr/bin/env python3
"""
Sync published notes from ~/wiki to the blog.

Usage: ./sync-notes [note-id ...]
       ./sync-notes              # sync all published notes
       ./sync-notes de14645c     # sync specific note(s)

For each published note:
  - Pulls latest content from ~/wiki/<id>.md
  - Uses wiki tags as the source of truth
  - Re-resolves wiki-links (picks up newly published links)
  - Updates the published: URL in the wiki note if needed
"""

import argparse
import re
import sys

from blog_utils import (
    WIKI_DIR,
    NOTES_DIR,
    BASE_URL,
    parse_frontmatter,
    parse_tags,
    slugify,
    resolve_wikilinks,
    extract_title,
    find_blog_note,
    extract_note_id,
    ensure_published_link,
    build_frontmatter,
    copy_images,
    sync_all_tag_artifacts,
)


def sync_note(note_id: str) -> list[str] | None:
    """
    Sync a single note from wiki to blog.

    Returns a list of change descriptions, or None if unchanged.
    """
    wiki_path = WIKI_DIR / f"{note_id}.md"
    blog_path = find_blog_note(note_id)

    if not wiki_path.exists():
        return [f"warning: wiki note not found: {wiki_path}"]

    if not blog_path:
        return ["warning: blog note not found (publish first)"]

    # Read wiki note
    wiki_content = wiki_path.read_text()
    wiki_meta, wiki_body = parse_frontmatter(wiki_content)

    # Read current blog note to preserve blog-specific metadata
    blog_content = blog_path.read_text()
    blog_meta, _ = parse_frontmatter(blog_content)

    # Extract title from wiki body
    title, body = extract_title(wiki_body)
    if not title:
        return [f"warning: no title found in {wiki_path}"]

    # Keep the original publication date from the blog
    jekyll_date = blog_meta.get("date", "")

    # Resolve wiki-links (re-resolve in case new notes are now published)
    body = resolve_wikilinks(body)

    # Copy images from wiki to blog
    body, copied_images = copy_images(
        body, note_id, frontmatter_image=wiki_meta.get("image", ""),
    )

    # Build slug and permalink
    slug = slugify(title)
    permalink = f"/{note_id}/{slug}"
    published_url = f"{BASE_URL}{permalink}"

    # Wiki is the source of truth for tags
    merged_tags = parse_tags(wiki_meta.get("tags", ""))

    # Collect old redirects and the old permalink (if slug changed)
    old_redirects = set()
    redirect_match = re.search(
        r"redirect_from:\s*\n((?:\s+-\s+[^\n]+\n?)+)",
        blog_content
    )
    if redirect_match:
        old_redirects.update(
            re.findall(r"-\s+(/[^\n]+)", redirect_match.group(1))
        )
    old_permalink = blog_meta.get("permalink", "")
    if old_permalink and old_permalink != permalink:
        old_redirects.add(old_permalink)

    # Build Jekyll frontmatter
    frontmatter = build_frontmatter(
        note_id, title, jekyll_date, merged_tags,
        wiki_meta, extra_redirects=old_redirects,
    )

    new_content = frontmatter + "\n\n" + body

    if not new_content.endswith("\n"):
        new_content += "\n"

    # Determine the correct filename (may have changed if title changed)
    new_filename = f"{note_id}-{slug}.md"
    new_blog_path = NOTES_DIR / new_filename

    # Check if content changed or filename needs updating
    content_changed = new_content != blog_content
    filename_changed = blog_path != new_blog_path
    details = []

    if content_changed or filename_changed:
        # Write updated blog note
        new_blog_path.write_text(new_content)

        if filename_changed and blog_path.exists():
            blog_path.unlink()
            details.append(
                f"renamed {blog_path.name} -> {new_blog_path.name}"
            )
        else:
            details.append("content updated")

    # Always ensure wiki note has correct published URL
    if ensure_published_link(wiki_path, published_url):
        details.append("fixed wiki backlink")

    if copied_images:
        details.append(
            f"{len(copied_images)} image(s) copied"
        )

    if details:
        return details
    return None


def main():
    parser = argparse.ArgumentParser(
        description="Sync published notes from ~/wiki to the blog."
    )
    parser.add_argument(
        "note_ids",
        nargs="*",
        help="Note IDs to sync (defaults to all published notes)"
    )
    args = parser.parse_args()

    # Get list of note IDs to sync
    if args.note_ids:
        note_ids = args.note_ids
    else:
        # Sync all notes in _notes/, skipping test- prefixed notes
        note_ids = [
            extract_note_id(p.name)
            for p in NOTES_DIR.glob("*.md")
            if not p.name.startswith("test-")
        ]

    if not note_ids:
        print("No notes to sync.")
        return

    print(f"Syncing {len(note_ids)} note(s)...")

    updated = 0
    for note_id in sorted(note_ids):
        details = sync_note(note_id)
        if details:
            if len(details) == 1:
                print(f"  {note_id}: {details[0]}")
            else:
                print(f"  {note_id}:")
                for detail in details:
                    print(f"    {detail}")
            updated += 1

    sync_all_tag_artifacts()
    unchanged = len(note_ids) - updated
    print(
        f"Done. Updated {updated} note(s), "
        f"{unchanged} note(s) unchanged."
    )


if __name__ == "__main__":
    main()
