#!/usr/bin/env python3
"""
Publish a note from ~/wiki to the blog.

Usage: ./publish-note <note-id> [--tags tag1,tag2]
Example: ./publish-note de14645c
         ./publish-note de14645c --tags article,japanese

Transforms:
  - Extracts title from # heading -> frontmatter title
  - Converts date format
  - Resolves wiki-links: [[id|text]]<!--wls--> -> [text](url) if published
  - Generates ID-based permalink: /note-id/slug-title
  - Adds redirect from /note-id
  - Adds published: URL backlink to original note
"""

import sys
from datetime import datetime, timezone

from blog_utils import (
    WIKI_DIR,
    NOTES_DIR,
    BASE_URL,
    parse_frontmatter,
    parse_tags,
    slugify,
    resolve_wikilinks,
    extract_title,
    ensure_published_link,
    build_frontmatter,
    copy_images,
    sync_all_tag_artifacts,
    commit_if_pending,
    jj_tug,
)


def publish_note(note_id: str, extra_tags: list[str] | None = None) -> str:
    """
    Publish a note to the blog.

    Args:
        note_id: The note ID (e.g., 'de14645c')
        extra_tags: Optional list of additional tags

    Returns:
        The published URL
    """
    wiki_path = WIKI_DIR / f"{note_id}.md"
    if not wiki_path.exists():
        raise FileNotFoundError(f"Note not found: {wiki_path}")

    content = wiki_path.read_text()
    metadata, body = parse_frontmatter(content)

    # Check if already published
    if "published" in metadata:
        print(f"Note already published: {metadata['published']}")
        return metadata["published"]

    # Extract title from body
    title, body = extract_title(body)
    if not title:
        raise ValueError("No title found (expected # heading)")

    # Separate any pre-existing WIP from this publish run.
    commit_if_pending()

    # Use current date as publication date with local timezone
    now = datetime.now().astimezone()
    jekyll_date = now.strftime("%Y-%m-%d %H:%M %z")

    # Resolve wiki-links
    body = resolve_wikilinks(body)

    # Copy images from wiki to blog
    body, _ = copy_images(
        body, note_id, frontmatter_image=metadata.get("image", ""),
    )

    # Build slug and permalink
    slug = slugify(title)

    # Collect tags
    tags = parse_tags(metadata.get("tags", ""))
    if extra_tags:
        tags.extend(extra_tags)

    # Build Jekyll frontmatter
    frontmatter = build_frontmatter(
        note_id, title, jekyll_date, tags, metadata,
    )

    jekyll_content = frontmatter + "\n\n" + body

    # Ensure content ends with newline
    if not jekyll_content.endswith("\n"):
        jekyll_content += "\n"

    # Write to _notes (filename includes slug for readability)
    note_filename = f"{note_id}-{slug}.md"
    note_path = NOTES_DIR / note_filename
    note_path.write_text(jekyll_content)
    print(f"Created: {note_path}")

    # Generate published URL
    permalink = f"/{note_id}/{slug}"
    published_url = f"{BASE_URL}{permalink}"

    # Add backlink to original note
    ensure_published_link(wiki_path, published_url)

    # Ensure feed and tag pages exist for any new tags
    sync_all_tag_artifacts()

    if commit_if_pending(f"Publish {title}"):
        jj_tug()

    return published_url


def main():
    if len(sys.argv) < 2:
        print("Usage: ./publish-note <note-id> [--tags tag1,tag2]")
        print("Example: ./publish-note de14645c")
        print("         ./publish-note de14645c --tags article,japanese")
        sys.exit(1)

    note_id = sys.argv[1]

    # Parse optional tags
    extra_tags = None
    if "--tags" in sys.argv:
        tags_idx = sys.argv.index("--tags")
        if tags_idx + 1 < len(sys.argv):
            extra_tags = [t.strip() for t in sys.argv[tags_idx + 1].split(",")]

    try:
        url = publish_note(note_id, extra_tags)
        print(f"\nPublished: {url}")
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except ValueError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
